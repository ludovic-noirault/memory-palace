# Copy to ~/.claude/palace.env and set YOUR absolute paths.
# Use absolute paths (or ~) — NOT $HOME: palace-map may read this file directly
# and does not shell-expand it. Precedence everywhere: real env var > this file > default.
#
# Defaults if this file is absent: VAULT_DIR=~/obsidian, PALACE_CLAUDE_DIR=~/.claude

VAULT_DIR=/Users/you/obsidian
PALACE_CLAUDE_DIR=/Users/you/.claude
