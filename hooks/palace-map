#!/usr/bin/env python3
"""palace-map — single source of truth for memory-palace project identity.

All hooks/scripts resolve project identity through THIS tool instead of
duplicating `case` lists. Canonical data lives in:
    ~/obsidian/projects/_mapping.json

Edit that JSON, then run `palace-map render` + `palace-map validate`.

Commands:
  resolve <pwd>     print slug whose glob matches <pwd> (first match wins); empty if none
  memdir  <slug>    print the auto-memory dir suffix for <slug>
  repo    <slug>    print the repo path for <slug> (with ~ expanded)
  list              print all slugs, one per line
  activity <slug>   print last-activity epoch seconds (git HEAD commit time), or empty
  quiz-status <slug> print NUDGE if the wing hasn't been quizzed in QUIZ_NUDGE_DAYS+ AND has recent activity
  validate          check every mapping has a wing + every wing is wired; exit 1 on ERROR
  render            rewrite the generated table region in _mapping.md from the JSON
  doctor            report per-wing staleness (behind activity) + dormancy (>90d idle)
  doctor --system   verify the whole install: config, hooks, launchd, paths, sync; exit 1 if any red
  archive <slug>    set the wing's readme frontmatter status: archived
  unarchive <slug>  set it back to status: active
  search <query> [--slug S] [--all]  keyword-overlap search over anticipated_queries frontmatter
"""
import fnmatch
import json
import os
import re
import subprocess
import sys
from pathlib import Path

def _load_env_file():
    """Parse palace.env (KEY=value). Located via $PALACE_ENV, else
    $PALACE_CLAUDE_DIR/palace.env, else ~/.claude/palace.env. Missing file is fine."""
    path = os.environ.get("PALACE_ENV") or os.path.join(
        os.environ.get("PALACE_CLAUDE_DIR", os.path.expanduser("~/.claude")), "palace.env")
    vals = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    vals[k.strip()] = v.strip()
    except OSError:
        pass
    return vals


_ENV_FILE = _load_env_file()


def _cfg(key, default):
    """Resolve a config value: real env var > palace.env > built-in default."""
    return os.environ.get(key) or _ENV_FILE.get(key) or default


VAULT_DIR = Path(os.path.expanduser(_cfg("VAULT_DIR", "~/obsidian")))
CLAUDE_DIR = Path(os.path.expanduser(_cfg("PALACE_CLAUDE_DIR", "~/.claude")))
VAULT_PROJECTS = VAULT_DIR / "projects"
MAPPING_JSON = VAULT_PROJECTS / "_mapping.json"
MAPPING_MD = VAULT_PROJECTS / "_mapping.md"
SESSIONS_DIR = VAULT_DIR / "claude-sessions"
TABLE_BEGIN = "<!-- palace-map:table:begin — generated by `palace-map render`, do not edit by hand -->"
TABLE_END = "<!-- palace-map:table:end -->"
DORMANT_DAYS = 90
STALE_DAYS = 3


def load():
    with open(MAPPING_JSON) as f:
        return json.load(f)["projects"]


def entry(slug):
    for p in load():
        if p["slug"] == slug:
            return p
    return None


def resolve(pwd):
    for p in load():
        for g in p["globs"]:
            if fnmatch.fnmatchcase(pwd, g):
                return p["slug"]
    return ""


def git_commit_epoch(repo):
    repo = Path(os.path.expanduser(repo))
    if not (repo / ".git").exists():
        return None
    try:
        out = subprocess.run(
            ["git", "-C", str(repo), "log", "-1", "--format=%ct"],
            capture_output=True, text=True, timeout=5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return int(out.stdout.strip())
    except (subprocess.SubprocessError, ValueError):
        pass
    return None


def newest_session_epoch(slug):
    """Newest mtime among claude-sessions transcripts tagged to slug. Bounded
    scan — used by `doctor`, not by the SessionStart hot path."""
    if not SESSIONS_DIR.exists():
        return None
    newest = None
    needle = f"projects: [{slug}"  # frontmatter list, slug may be first of several
    alt = f"- {slug}"
    for f in SESSIONS_DIR.rglob("*.md"):
        try:
            head = f.read_text(errors="ignore")[:1500]
        except OSError:
            continue
        if needle in head or (f"projects:" in head and alt in head):
            m = f.stat().st_mtime
            if newest is None or m > newest:
                newest = m
    return int(newest) if newest else None


def wing_files_mtime(slug):
    d = VAULT_PROJECTS / slug
    if not d.is_dir():
        return None
    mtimes = [p.stat().st_mtime for p in d.glob("*.md") if p.is_file()]
    return int(max(mtimes)) if mtimes else None


_WORD_RE = re.compile(r"[a-z0-9]+")


def _words(text):
    return set(_WORD_RE.findall(text.lower()))


def _frontmatter_block(text):
    """Raw text between the first two '---' lines, or '' if there's no frontmatter block."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return ""
    try:
        end = lines[1:].index("---") + 1
    except ValueError:
        return ""
    return "\n".join(lines[1:end])


def anticipated_queries(path):
    """Parse the anticipated_queries: YAML list from a doc's frontmatter. Never raises —
    missing field, no frontmatter, or a malformed (non-list) value all return []."""
    try:
        text = path.read_text(errors="ignore")
    except OSError:
        return []
    block = _frontmatter_block(text)
    if not block:
        return []
    out = []
    in_list = False
    for line in block.splitlines():
        stripped = line.strip()
        if stripped.startswith("anticipated_queries:"):
            in_list = True
            continue
        if in_list and stripped.startswith("- "):
            item = stripped[2:].strip().strip('"').strip("'").strip()
            if item:
                out.append(item)
        elif in_list:
            in_list = False
    return out


def _wing_docs(slug):
    d = VAULT_PROJECTS / slug
    if not d.is_dir():
        return []
    docs = list(d.glob("*.md"))
    feat_dir = d / "features"
    if feat_dir.is_dir():
        docs += list(feat_dir.glob("*.md"))
    return docs


def cmd_search(args):
    slug_filter = None
    words = []
    it = iter(args)
    for a in it:
        if a == "--slug":
            slug_filter = next(it, None)
        elif a == "--all":
            pass
        else:
            words.append(a)
    if not words:
        print("usage: palace-map search <query> [--slug SLUG] [--all]")
        sys.exit(2)
    q_words = _words(" ".join(words))
    slugs = [slug_filter] if slug_filter else [p["slug"] for p in load()]
    results = []
    for slug in slugs:
        d = VAULT_PROJECTS / slug
        if not d.is_dir():
            continue
        for doc in _wing_docs(slug):
            rel = doc.relative_to(d)
            for aq in anticipated_queries(doc):
                score = len(q_words & _words(aq))
                if score > 0:
                    results.append((score, slug, str(rel), aq))
    results.sort(key=lambda r: -r[0])
    if not results:
        print("no matches")
        return
    for score, slug, rel, aq in results[:8]:
        print(f'{slug}/{rel} — "{aq}" ({score})')


def cmd_resolve(args):
    print(resolve(args[0] if args else ""))


def cmd_memdir(args):
    e = entry(args[0]) if args else None
    print(e["memdir"] if e else "")


def cmd_repo(args):
    e = entry(args[0]) if args else None
    print(os.path.expanduser(e["repo"]) if e else "")


def cmd_list(args):
    for p in load():
        print(p["slug"])


def cmd_activity(args):
    e = entry(args[0]) if args else None
    if not e:
        return
    ep = git_commit_epoch(e["repo"])
    if ep:
        print(ep)


def _validate():
    """Return (errors, warns) lists without exiting. Shared by cmd_validate + doctor --system."""
    projects = load()
    slugs = {p["slug"] for p in projects}
    errors, warns = [], []
    for p in projects:
        if not p.get("globs"):
            errors.append(f"{p['slug']}: no globs")
        if not p.get("memdir"):
            errors.append(f"{p['slug']}: no memdir")
        if not (VAULT_PROJECTS / p["slug"]).is_dir():
            errors.append(f"{p['slug']}: mapping has no wing dir projects/{p['slug']}/ (dead config)")
    for d in sorted(VAULT_PROJECTS.iterdir()):
        if d.is_dir() and not d.name.startswith(".") and d.name not in slugs:
            warns.append(f"wing projects/{d.name}/ exists but is NOT in _mapping.json (unwired)")
    return errors, warns


def cmd_validate(args):
    projects = load()
    errors, warns = _validate()
    for w in warns:
        print(f"WARN  {w}")
    for e in errors:
        print(f"ERROR {e}")
    if not errors and not warns:
        print(f"OK    {len(projects)} projects, all wired, all wings mapped")
    sys.exit(1 if errors else 0)


def _table_text():
    rows = ["| Palace wing (`projects/{x}`) | `$PWD` match(es) | Auto-memory dir suffix | Repo path |",
            "|---|---|---|---|"]
    for p in load():
        globs = " or ".join(f"`{g}`" for g in p["globs"])
        rows.append(f"| `{p['slug']}` | {globs} | `{p['memdir']}` | `{p['repo']}` |")
    return "\n".join(rows)


def cmd_render(args):
    table = _table_text()
    text = MAPPING_MD.read_text()
    if TABLE_BEGIN not in text or TABLE_END not in text:
        print(f"ERROR: markers not found in {MAPPING_MD}. Add:\n{TABLE_BEGIN}\n{TABLE_END}")
        sys.exit(1)
    pre = text.split(TABLE_BEGIN)[0]
    post = text.split(TABLE_END)[1]
    MAPPING_MD.write_text(f"{pre}{TABLE_BEGIN}\n{table}\n{TABLE_END}{post}")
    print(f"rendered {len(load())} rows into {MAPPING_MD.name}")


def _table_in_sync():
    """True if _mapping.md's table region already equals a fresh render (render = no-op)."""
    try:
        text = MAPPING_MD.read_text()
    except OSError:
        return False
    if TABLE_BEGIN not in text or TABLE_END not in text:
        return False
    current = text.split(TABLE_BEGIN)[1].split(TABLE_END)[0]
    return current == f"\n{_table_text()}\n"


def context_mtime(slug):
    f = VAULT_PROJECTS / slug / "CONTEXT.md"
    return int(f.stat().st_mtime) if f.is_file() else None


def is_archived(slug):
    f = VAULT_PROJECTS / slug / "readme.md"
    if not f.is_file():
        return False
    head = f.read_text(errors="ignore")[:600]
    return "status: archived" in head


QUIZ_NUDGE_DAYS = 4


def quiz_log_last_date(slug):
    """Epoch seconds of the last dated row in QUIZ_LOG.md, or None if never quizzed."""
    f = VAULT_PROJECTS / slug / "QUIZ_LOG.md"
    if not f.is_file():
        return None
    rows = [l for l in f.read_text().splitlines() if l.strip().startswith("|") and "---" not in l]
    if len(rows) <= 1:  # header only (or nothing) — no quiz run yet
        return None
    cols = [c.strip() for c in rows[-1].split("|") if c.strip()]
    if not cols:
        return None
    try:
        import datetime
        dt = datetime.datetime.strptime(cols[0], "%Y-%m-%d").replace(tzinfo=datetime.timezone.utc)
        return int(dt.timestamp())
    except ValueError:
        return None


def cmd_quiz_status(args):
    """Print NUDGE if it's been >= QUIZ_NUDGE_DAYS since the wing's last quiz AND the
    wing has real recent activity (not dormant) — else print nothing."""
    slug = args[0] if args else None
    e = entry(slug) if slug else None
    if not e:
        return
    import time
    now = int(time.time())
    act = git_commit_epoch(e["repo"]) or newest_session_epoch(slug)
    if not act or (now - act) // 86400 > DORMANT_DAYS:
        return  # dormant or no activity signal — don't nag a dead project
    last_quiz = quiz_log_last_date(slug)
    if last_quiz is None or (now - last_quiz) // 86400 >= QUIZ_NUDGE_DAYS:
        print("NUDGE")


def _doctor_system():
    """Verify the WIRING (not just wing freshness): config, hooks, launchd, paths, sync.
    Prints one line per check; exits non-zero if any red."""
    import subprocess as sp
    checks = []  # (ok, label, detail)

    def ck(ok, label, detail=""):
        checks.append((bool(ok), label, detail))

    # 1. config file
    envf = CLAUDE_DIR / "palace.env"
    ck(envf.is_file(), "palace.env present", str(envf))

    # 2. settings.json valid + hooks wired
    settings = CLAUDE_DIR / "settings.json"
    stext = ""
    try:
        stext = settings.read_text()
        json.loads(stext)
        ck(True, "settings.json valid JSON")
    except (OSError, ValueError) as e:
        ck(False, "settings.json valid JSON", str(e))
    for needle, label in [
        ("palace-context.sh", "SessionStart hook (palace-context.sh)"),
        ("palace-map resolve", "Stop hook (palace-map → palace-to-memory)"),
        ("claude-sessions", "Stop hook (session sync)"),
        ("index-sessions.sh", "Stop hook (QMD index)"),
        ("palace-reminder.sh", "SessionEnd hook (reminder)"),
    ]:
        ck(needle in stext, label)

    # 3. launchd daily job
    try:
        ll = sp.run(["launchctl", "list"], capture_output=True, text=True, timeout=5).stdout
        ck("palace-maintenance" in ll, "launchd daily job loaded")
    except (sp.SubprocessError, OSError) as e:
        ck(False, "launchd daily job loaded", str(e))

    # 4. referenced scripts + vault paths exist
    for rel, base in [
        ("hooks/palace-map", CLAUDE_DIR), ("hooks/palace-context.sh", CLAUDE_DIR),
        ("hooks/palace-reminder.sh", CLAUDE_DIR), ("hooks/palace-daily-maintenance.sh", CLAUDE_DIR),
        ("hooks/scan-secrets.py", CLAUDE_DIR), ("hooks/index-sessions.sh", CLAUDE_DIR),
        ("skills/sync-claude-sessions/scripts/palace-to-memory", CLAUDE_DIR),
        ("skills/sync-claude-sessions/scripts/claude-sessions", CLAUDE_DIR),
        ("skills/recall/scripts/palace-harvest.py", CLAUDE_DIR),
    ]:
        ck((base / rel).exists(), f"path exists: {rel}")
    ck(VAULT_PROJECTS.is_dir(), "vault projects dir", str(VAULT_PROJECTS))
    ck(MAPPING_JSON.is_file(), "_mapping.json present")
    ck(MAPPING_MD.is_file(), "_mapping.md present")

    # 5. every wing has its 6 files
    missing = []
    for p in load():
        d = VAULT_PROJECTS / p["slug"]
        for f in ("readme.md", "ARCHITECTURE.md", "BUGS.md", "CONTEXT.md", "DECISIONS.md", "GLOSSARY.md"):
            if not (d / f).is_file():
                missing.append(f"{p['slug']}/{f}")
    ck(not missing, "every wing has its 6 files", ", ".join(missing[:5]))

    # 6. _mapping.md table in sync with _mapping.json
    ck(_table_in_sync(), "_mapping.md table in sync (render = no-op)", "run `palace-map render`")

    # 7. mapping validate
    errors, warns = _validate()
    ck(not errors, "mapping validate (no orphan mappings)", "; ".join(errors[:3]))
    if warns:
        ck(True, f"validate warnings ({len(warns)})", "; ".join(w.split(' exists')[0] for w in warns[:3]))

    red = 0
    for ok, label, detail in checks:
        mark = "✓" if ok else "✗"
        if not ok:
            red += 1
        line = f"  {mark} {label}"
        if detail and not ok:
            line += f"  — {detail}"
        print(line)
    print(f"\n{'ALL GREEN' if not red else str(red) + ' RED'} ({len(checks)} checks)")
    sys.exit(1 if red else 0)


def cmd_doctor(args):
    if "--system" in args:
        _doctor_system()
        return
    import time
    now = int(time.time())
    # Dormancy keys off real ACTIVITY (git commits / tagged sessions), NOT wing-file
    # mtime — editing a doc must not make a dead project look alive. Staleness compares
    # CONTEXT.md against activity (same signal the SessionStart guard uses).
    print(f"{'wing':32} {'last activity':14} {'status'}")
    for p in load():
        slug = p["slug"]
        if is_archived(slug):
            print(f"{slug:32} {'-':14} archived")
            continue
        act = git_commit_epoch(p["repo"]) or newest_session_epoch(slug)
        ctx = context_mtime(slug)
        act_d = (now - act) // 86400 if act else None
        status = "ok"
        if act and ctx and act > ctx + STALE_DAYS * 86400:
            status = f"STALE — activity {act_d}d ago, CONTEXT.md older → /palace:update"
        elif act_d is not None and act_d > DORMANT_DAYS:
            status = f"DORMANT — {act_d}d since last activity → consider `status: archived`"
        elif act is None:
            status = "no activity signal (not a local git repo, no tagged sessions) → verify repo path or archive"
        if status == "ok" and quiz_log_last_date(slug) is None:
            status = "ok (never quizzed — try /palace:quiz)"
        print(f"{slug:32} {(str(act_d)+'d ago' if act_d is not None else '—'):14} {status}")


def _set_status(slug, value):
    f = VAULT_PROJECTS / slug / "readme.md"
    if not f.is_file():
        print(f"ERROR: no readme.md for {slug}")
        sys.exit(1)
    text = f.read_text()
    if re.search(r"(?m)^status:\s*.*$", text):
        text = re.sub(r"(?m)^status:\s*.*$", f"status: {value}", text, count=1)
    else:  # insert into frontmatter if missing
        text = re.sub(r"(?s)^(---\n)", rf"\1status: {value}\n", text, count=1)
    f.write_text(text)
    print(f"{slug}: status: {value}")


def cmd_archive(args):
    _set_status(args[0], "archived")


def cmd_unarchive(args):
    _set_status(args[0], "active")


CMDS = {
    "resolve": cmd_resolve, "memdir": cmd_memdir, "repo": cmd_repo, "list": cmd_list,
    "activity": cmd_activity, "validate": cmd_validate, "render": cmd_render, "doctor": cmd_doctor,
    "archive": cmd_archive, "unarchive": cmd_unarchive, "quiz-status": cmd_quiz_status,
    "search": cmd_search,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print(__doc__)
        sys.exit(2)
    CMDS[sys.argv[1]](sys.argv[2:])
